# Local deterministic mode (default; no API key required)
ESA_LLM_PROVIDER=mock
ESA_LLM_MODEL=gpt-4.1-mini

# Optional provider settings
# OPENAI_API_KEY=
# ESA_LLM_PROVIDER=openai
# ESA_API_BASE_URL=https://api.openai.com/v1
# ESA_LLM_PROVIDER=ollama
# ESA_OLLAMA_BASE_URL=http://localhost:11434
# ESA_LLM_MODEL=deepseek-r1:8b
# ESA_PDFTOPPM_PATH=C:/path/to/pdftoppm.exe

ESA_MAX_TURNS=8
ESA_MODEL_RETRIES=1
ESA_TOOL_RETRIES=1
ESA_TOOL_TIMEOUT_SECONDS=3
ESA_REPEATED_CALL_THRESHOLD=2
ESA_NO_PROGRESS_THRESHOLD=3
ESA_RAG_TOP_K=3
